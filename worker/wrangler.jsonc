
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wowseru-ai-animasi-mcp",
  "main": "server.js",
  "compatibility_date": "2026-11-08",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "APPROVALS", "class_name": "ApprovalStore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ApprovalStore"] }
  ]
}
